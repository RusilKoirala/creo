[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/health_bar.gd" id="1_script"]
[ext_resource type="FontFile" path="res://assets/fonts/PixelOperator8-Bold.ttf" id="2_font"]

[sub_resource type="StyleBoxFlat" id="frame"]
bg_color = Color(0.12, 0.1, 0.16, 0.92)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(1, 0.86, 0.2, 1)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12
corner_detail = 8
shadow_color = Color(0, 0, 0, 0.4)
shadow_size = 4
shadow_offset = Vector2(0, 4)
content_margin_left = 12.0
content_margin_top = 8.0
content_margin_right = 12.0
content_margin_bottom = 8.0

[sub_resource type="StyleBoxFlat" id="track"]
bg_color = Color(0, 0, 0, 0.55)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

[sub_resource type="StyleBoxFlat" id="trail_fill"]
bg_color = Color(1, 0.95, 0.85, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

[sub_resource type="StyleBoxEmpty" id="none"]

[sub_resource type="StyleBoxFlat" id="hp_fill"]
bg_color = Color(0.4, 0.85, 0.35, 1)
border_width_top = 3
border_color = Color(1, 1, 1, 0.3)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

[node name="HealthBar" type="PanelContainer"]
theme_override_styles/panel = SubResource("frame")
script = ExtResource("1_script")

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="HP" type="Label" parent="Row"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.86, 0.2, 1)
theme_override_colors/font_shadow_color = Color(0, 0, 0, 0.6)
theme_override_constants/shadow_offset_x = 0
theme_override_constants/shadow_offset_y = 2
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 16
text = "HP"

[node name="Bar" type="Control" parent="Row"]
custom_minimum_size = Vector2(160, 20)
layout_mode = 2
size_flags_vertical = 4

[node name="Trail" type="ProgressBar" parent="Row/Bar"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/background = SubResource("track")
theme_override_styles/fill = SubResource("trail_fill")
max_value = 3.0
step = 0.01
value = 3.0
show_percentage = false

[node name="Fill" type="ProgressBar" parent="Row/Bar"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/background = SubResource("none")
theme_override_styles/fill = SubResource("hp_fill")
max_value = 3.0
step = 0.01
value = 3.0
show_percentage = false

[node name="Ticks" type="Control" parent="Row/Bar"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Value" type="Label" parent="Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(44, 0)
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_shadow_color = Color(0, 0, 0, 0.6)
theme_override_constants/shadow_offset_x = 0
theme_override_constants/shadow_offset_y = 2
theme_override_fonts/font = ExtResource("2_font")
theme_override_font_sizes/font_size = 16
text = "3/3"
horizontal_alignment = 2
